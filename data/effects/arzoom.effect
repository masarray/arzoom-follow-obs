/*
 * ArZoom - Smart Zone Camera + GPU Click Visualization for OBS
 * One-pass viewport transform + water-surface click refraction.
 * GPL-2.0-or-later
 */

uniform float4x4 ViewProj;
uniform texture2d image;

/* Camera ABI. */
uniform float zoom_amount;
uniform float2 zoom_center;

/* Click ABI: xy=content position, z=age seconds, w=click type.
 * type: 0=inactive, 1=left, 2=right, 3=middle. */
uniform float2 viewport_size;
uniform float4 click_event0;
uniform float4 click_event1;
uniform float4 click_event2;
uniform float4 click_event3;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

struct VertOut {
    float2 uv  : TEXCOORD0;
    float4 pos : POSITION;
};

struct FragData {
    float2 uv : TEXCOORD0;
};

VertOut VSDefault(VertData v_in)
{
    VertOut v_out;
    v_out.uv = v_in.uv;
    v_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    return v_out;
}

float ease_out_cubic(float t)
{
    t = saturate(t);
    const float q = 1.0 - t;
    return 1.0 - q * q * q;
}

float ease_in_out(float t)
{
    t = saturate(t);
    return t * t * (3.0 - 2.0 * t);
}

float ring_mask(float distance_px, float radius_px, float width_px)
{
    const float edge = abs(distance_px - radius_px);
    return 1.0 - smoothstep(width_px, width_px + 1.25, edge);
}

float event_lifetime(float type)
{
    if (type < 1.5)
        return 0.46;
    if (type < 2.5)
        return 0.54;
    return 0.38;
}

float2 event_center(float4 event_data, float safe_zoom)
{
    return float2(0.5, 0.5) +
           (event_data.xy - zoom_center) * safe_zoom;
}

float2 event_delta_px(float2 output_uv, float4 event_data,
                      float safe_zoom, float2 safe_viewport)
{
    return (output_uv - event_center(event_data, safe_zoom)) *
           safe_viewport;
}

/* A click is modelled as a short finger press into a flexible water surface:
 *   1) contact pressure builds a local dimple;
 *   2) the dimple releases;
 *   3) one clean refractive wave travels outward and settles.
 *
 * The returned vector is a pixel-space displacement used BEFORE sampling the
 * captured frame. This is the key difference from the old overlay-only ring:
 * content itself bends around the click, creating actual visual depth. */
float2 water_displacement_px(float2 delta_px, float age, float type)
{
    if (type < 0.5)
        return float2(0.0, 0.0);

    const float distance_px = max(length(delta_px), 0.001);
    const float2 direction = delta_px / distance_px;

    const float type_scale =
        type < 1.5 ? 1.0 : (type < 2.5 ? 0.88 : 0.70);

    /* Soft contact: fast enough to feel responsive, slow enough that the eye
     * reads a surface being pressed rather than a flash. */
    const float press_in = smoothstep(0.0, 0.030, age);
    const float press_out = 1.0 - smoothstep(0.070, 0.125, age);
    const float press = press_in * press_out;
    const float dimple_radius = 29.0 * type_scale;
    const float dimple_shape =
        1.0 - smoothstep(0.0, dimple_radius, distance_px);
    const float dimple_displacement =
        3.8 * type_scale * press * dimple_shape * dimple_shape;

    /* Rebound wave. The signed profile bends pixels in opposite directions on
     * the leading/trailing sides of the crest, which reads as refraction rather
     * than as a painted ring. */
    const float wave_t = saturate((age - 0.065) /
                                  (event_lifetime(type) - 0.065));
    const float wave_active = age > 0.055 ? 1.0 : 0.0;
    const float wave_radius =
        10.0 + (type < 1.5 ? 68.0 : (type < 2.5 ? 62.0 : 43.0)) *
        ease_out_cubic(wave_t);
    const float wave_width = type < 2.5 ? 13.0 : 10.0;
    const float q = (distance_px - wave_radius) / wave_width;
    const float compact = 1.0 - smoothstep(0.0, 1.0, abs(q));
    const float signed_wave = -q * compact * compact;
    const float wave_fade =
        (1.0 - smoothstep(0.58, 1.0, wave_t)) * wave_active;
    float ripple_displacement =
        5.2 * type_scale * signed_wave * wave_fade;

    /* Right click gets a restrained secondary echo instead of a noisy outline. */
    if (type >= 1.5 && type < 2.5) {
        const float echo_t = saturate((age - 0.115) / 0.38);
        const float echo_radius = 8.0 + 48.0 * ease_out_cubic(echo_t);
        const float echo_q = (distance_px - echo_radius) / 10.5;
        const float echo_compact =
            1.0 - smoothstep(0.0, 1.0, abs(echo_q));
        ripple_displacement +=
            1.8 * (-echo_q) * echo_compact * echo_compact *
            (1.0 - smoothstep(0.50, 1.0, echo_t));
    }

    return direction * (dimple_displacement + ripple_displacement);
}

/* Visual depth lighting for the dimple and travelling refractive crest.
 * This stays deliberately subtle: refraction is the hero, color is only an
 * accessibility/contrast cue for flat white or flat dark surfaces. */
float3 shade_water_click(float3 base, float2 delta_px, float age,
                         float type)
{
    if (type < 0.5)
        return base;

    const float distance_px = max(length(delta_px), 0.001);
    const float2 direction = delta_px / distance_px;
    const float type_scale =
        type < 1.5 ? 1.0 : (type < 2.5 ? 0.88 : 0.70);

    const float press_in = smoothstep(0.0, 0.030, age);
    const float press_out = 1.0 - smoothstep(0.070, 0.135, age);
    const float press = press_in * press_out;
    const float dimple_radius = 29.0 * type_scale;
    const float dimple =
        (1.0 - smoothstep(0.0, dimple_radius, distance_px)) * press;
    const float dimple_rim =
        ring_mask(distance_px, dimple_radius * 0.74, 4.8) * press;

    const float3 light_dir3 = normalize(float3(-0.62, -0.78, 0.0));
    const float rim_light =
        saturate(dot(float3(direction, 0.0), -light_dir3));
    const float rim_shadow =
        saturate(dot(float3(direction, 0.0), light_dir3));

    const float luminance = dot(base, float3(0.2126, 0.7152, 0.0722));
    const float bright_surface = smoothstep(0.58, 0.90, luminance);

    /* Depression: gentle center darkening plus directional rim light/shadow.
     * On white UIs the shadow carries the shape; on dark UIs the highlight does. */
    const float center_depth = dimple * (0.045 + 0.045 * bright_surface);
    base *= 1.0 - center_depth;
    base *= 1.0 - dimple_rim * rim_shadow *
                  (0.055 + 0.070 * bright_surface);
    base += (1.0 - base) * dimple_rim * rim_light *
            (0.075 + 0.035 * (1.0 - bright_surface));

    const float wave_t = saturate((age - 0.065) /
                                  (event_lifetime(type) - 0.065));
    const float wave_active = age > 0.055 ? 1.0 : 0.0;
    const float wave_radius =
        10.0 + (type < 1.5 ? 68.0 : (type < 2.5 ? 62.0 : 43.0)) *
        ease_out_cubic(wave_t);
    const float wave_fade =
        (1.0 - smoothstep(0.58, 1.0, wave_t)) * wave_active;

    const float crest = ring_mask(distance_px, wave_radius, 2.2) * wave_fade;
    const float inner_shadow =
        ring_mask(distance_px, wave_radius - 3.6, 2.6) * wave_fade;
    const float outer_sheen =
        ring_mask(distance_px, wave_radius + 2.9, 2.4) * wave_fade;

    const float3 accent =
        type < 1.5 ? float3(0.05, 0.69, 0.92) :
        (type < 2.5 ? float3(0.57, 0.32, 0.91) :
                      float3(0.95, 0.62, 0.10));

    /* On bright surfaces use a chromatic shadow edge; on dark surfaces use a
     * soft caustic highlight. No thick neon ring and no random/noise wobble. */
    const float3 dark_accent = accent * 0.28;
    base = lerp(base, dark_accent,
                inner_shadow * (0.035 + 0.16 * bright_surface));
    base += (1.0 - base) * outer_sheen *
            (0.085 + 0.065 * (1.0 - bright_surface));
    base = lerp(base, accent,
                crest * (0.055 + 0.055 * bright_surface));

    return saturate(base);
}

float2 click_displacement(float2 output_uv, float4 event_data,
                          float safe_zoom, float2 safe_viewport)
{
    if (event_data.w < 0.5)
        return float2(0.0, 0.0);
    const float2 delta_px = event_delta_px(
        output_uv, event_data, safe_zoom, safe_viewport);
    return water_displacement_px(delta_px, event_data.z, event_data.w);
}

float3 apply_click_shading(float3 base, float2 output_uv,
                           float4 event_data, float safe_zoom,
                           float2 safe_viewport)
{
    if (event_data.w < 0.5)
        return base;
    const float2 delta_px = event_delta_px(
        output_uv, event_data, safe_zoom, safe_viewport);
    return shade_water_click(base, delta_px, event_data.z, event_data.w);
}

float4 PSZoom(FragData f_in) : TARGET
{
    const float safe_zoom = max(zoom_amount, 1.0);
    const float2 safe_viewport = max(viewport_size, float2(1.0, 1.0));

    /* Sum the tiny fixed-slot water displacement fields, then sample the frame
     * once. This keeps Phase 2 in the same single GPU pass with no frame
     * readback, particles, temporary textures, or extra OBS source. */
    float2 displacement_px = float2(0.0, 0.0);
    displacement_px += click_displacement(
        f_in.uv, click_event0, safe_zoom, safe_viewport);
    displacement_px += click_displacement(
        f_in.uv, click_event1, safe_zoom, safe_viewport);
    displacement_px += click_displacement(
        f_in.uv, click_event2, safe_zoom, safe_viewport);
    displacement_px += click_displacement(
        f_in.uv, click_event3, safe_zoom, safe_viewport);
    displacement_px = clamp(
        displacement_px, float2(-8.0, -8.0), float2(8.0, 8.0));

    const float2 warped_output_uv =
        f_in.uv + displacement_px / safe_viewport;
    const float2 sample_uv =
        zoom_center +
        (warped_output_uv - float2(0.5, 0.5)) / safe_zoom;

    /* Clamp sampler + saturate guard guarantee fail-safe edge behavior. */
    float4 color = image.Sample(textureSampler, saturate(sample_uv));

    color.rgb = apply_click_shading(
        color.rgb, f_in.uv, click_event0, safe_zoom, safe_viewport);
    color.rgb = apply_click_shading(
        color.rgb, f_in.uv, click_event1, safe_zoom, safe_viewport);
    color.rgb = apply_click_shading(
        color.rgb, f_in.uv, click_event2, safe_zoom, safe_viewport);
    color.rgb = apply_click_shading(
        color.rgb, f_in.uv, click_event3, safe_zoom, safe_viewport);
    return color;
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = PSZoom(f_in);
    }
}
