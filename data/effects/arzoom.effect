/*
 * ArZoom - Smart Zone Camera + GPU Presentation Feedback for OBS
 * One-pass viewport transform + premium click rings + Presentation Cursor.
 * GPL-2.0-or-later
 */

uniform float4x4 ViewProj;
uniform texture2d image;
uniform texture2d cursor_atlas;
uniform texture2d keycap_atlas;

/* Camera ABI. */
uniform float zoom_amount;
uniform float2 zoom_center;

/* P5 Spotlight ABI.
 * Center is already expressed in final output UV space. Size/feather/corner
 * are final-output pixels so Spotlight never grows with camera zoom.
 * shape: 0=ellipse, 1=rounded rectangle. The CPU presentation layer owns
 * mode semantics; the shader owns appearance only.
 * P5.1 adds an output-space area multiplier plus a true-circle coercion.
 * P5.5 adds two scalar choreography multipliers. They never add a texture or
 * pass: cinematic_scale expands the existing analytic aperture, while
 * cinematic_dim_mix ramps the existing multiplicative dim. */
uniform float spotlight_enabled;
uniform float2 spotlight_center;
uniform float2 spotlight_half_size_px;
uniform float spotlight_feather_px;
uniform float spotlight_dim_strength;
uniform float spotlight_shape;
uniform float spotlight_corner_radius_px;
uniform float spotlight_area_scale;
uniform float spotlight_circle;
uniform float spotlight_cinematic_scale;
uniform float spotlight_cinematic_dim_mix;

/* Click ABI: xy=content position, z=age seconds, w=click type.
 * type: 0=inactive, 1=left, 2=right, 3=middle. */
uniform float2 viewport_size;
uniform float4 click_event0;
uniform float4 click_event1;
uniform float4 click_event2;
uniform float4 click_event3;

/* Presentation Cursor ABI.
 * Cursor position is stored in the same source/content coordinate system used
 * by click events. Size is deliberately output-pixel constant while the
 * hotspot follows the camera transform exactly. */
uniform float2 cursor_content_position;
uniform float2 cursor_asset_size;
uniform float2 cursor_hotspot;
uniform float2 cursor_atlas_grid;
uniform float cursor_frame;
uniform float cursor_size_px;
uniform float cursor_visible;

/* Event-driven physical keycap atlas; neutral opacity MUST be primed. */
uniform float2 keycap_size_px;
uniform float keycap_opacity;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

sampler_state cursorSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

sampler_state keycapSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

struct VertOut {
    float2 uv  : TEXCOORD0;
    float4 pos : POSITION;
};

struct FragData {
    float2 uv : TEXCOORD0;
};

VertOut VSDefault(VertData v_in)
{
    VertOut v_out;
    v_out.uv = v_in.uv;
    v_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    return v_out;
}

/* Arssyut P4R.3 premium click: smooth expansion and one analytic ring. */
float smooth_out(float progress)
{
    const float t = saturate(progress);
    const float inv = 1.0 - t;
    return 1.0 - inv * inv * inv;
}

float vector_ring(float distance_px, float radius_px, float half_width_px)
{
    const float edge = abs(distance_px - radius_px);
    return 1.0 - smoothstep(half_width_px,
                            half_width_px + 1.25,
                            edge);
}

float event_lifetime(float type)
{
    if (type < 1.5)
        return 0.88;
    if (type < 2.5)
        return 0.90;
    return 0.84;
}

float2 project_content(float2 content_position, float safe_zoom)
{
    return float2(0.5, 0.5) +
           (content_position - zoom_center) * safe_zoom;
}

float spotlight_ellipse_distance_px(float2 delta_px, float2 half_size_px)
{
    const float2 safe_half = max(half_size_px, float2(1.0, 1.0));
    const float2 normalized = delta_px / safe_half;
    return (length(normalized) - 1.0) * min(safe_half.x, safe_half.y);
}

float spotlight_rounded_rect_distance_px(float2 delta_px,
                                         float2 half_size_px,
                                         float corner_radius_px)
{
    const float2 safe_half = max(half_size_px, float2(1.0, 1.0));
    const float radius = clamp(corner_radius_px, 0.0,
                               min(safe_half.x, safe_half.y));
    const float2 q = abs(delta_px) - (safe_half - float2(radius, radius));
    return length(max(q, float2(0.0, 0.0))) +
           min(max(q.x, q.y), 0.0) - radius;
}

/* Premium Spotlight is intentionally just a soft multiplicative attention
 * mask. It does not blur, glow, sample a second texture, or alter camera
 * semantics. Click feedback and Presentation Cursor are composited later so
 * they remain legible even over the dimmed context. */
float3 apply_spotlight(float3 base, float2 output_uv,
                       float2 safe_viewport)
{
    if (spotlight_enabled < 0.5)
        return base;

    const float area_scale = clamp(
        spotlight_area_scale * max(spotlight_cinematic_scale, 1.0),
        0.5, 64.0);
    float2 safe_half = max(spotlight_half_size_px * area_scale,
                           float2(1.0, 1.0));
    if (spotlight_circle >= 0.5) {
        const float radius = min(safe_half.x, safe_half.y);
        safe_half = float2(radius, radius);
    }

    const float2 delta_px =
        (output_uv - saturate(spotlight_center)) * safe_viewport;

    float signed_distance_px = spotlight_ellipse_distance_px(
        delta_px, safe_half);
    if (spotlight_shape >= 0.5 && spotlight_circle < 0.5) {
        signed_distance_px = spotlight_rounded_rect_distance_px(
            delta_px, safe_half, spotlight_corner_radius_px * area_scale);
    }

    const float feather = max(spotlight_feather_px, 1.0);
    const float focus = 1.0 - smoothstep(0.0, feather,
                                        signed_distance_px);
    const float dim = clamp(
        spotlight_dim_strength * saturate(spotlight_cinematic_dim_mix),
        0.0, 0.75);
    const float multiplier = 1.0 - dim * (1.0 - focus);
    return base * multiplier;
}

float2 event_center(float4 event_data, float safe_zoom)
{
    return project_content(event_data.xy, safe_zoom);
}

float2 event_delta_px(float2 output_uv, float4 event_data,
                      float safe_zoom, float2 safe_viewport)
{
    return (output_uv - event_center(event_data, safe_zoom)) *
           safe_viewport;
}

/* Premium single-ring click V2 (adapted from Arssyut P4R.3).
 * A bright core, near bloom and diffuse halo all share one signed distance
 * from the same ring. This is NOT a second circle or a bloom render pass.
 * Content anchoring and the complete OBS Draw parameter ABI are unchanged. */
float3 click_color(float type)
{
    if (type < 1.5)
        return float3(0.196, 0.722, 1.000); // sky, #32B8FF
    if (type < 2.5)
        return float3(1.000, 0.361, 0.541); // rose, #FF5C8A
    return float3(1.000, 0.784, 0.341);     // amber, #FFC857
}

float3 composite_single_ring(float3 base, float2 delta_px,
                             float progress, float type,
                             float2 safe_viewport)
{
    progress = saturate(progress);

    const float scale = clamp(
        min(safe_viewport.x, safe_viewport.y) / 1080.0,
        0.85, 1.60);
    const float expansion = smooth_out(progress);
    const float radius_px = lerp(10.5, 64.0, expansion) * scale;
    const float half_width_px = lerp(3.90, 2.25, progress) * scale;
    const float distance_px = length(delta_px);
    const float edge = abs(distance_px - radius_px);

    /* Fast ignition with a longer tail: core vanishes before the halo. */
    const float ignition = smoothstep(0.0, 0.035, progress);
    const float core_fade = 1.0 - smoothstep(0.48, 0.94, progress);
    const float bloom_fade = 1.0 - smoothstep(0.58, 1.00, progress);

    const float core = vector_ring(
        distance_px, radius_px, half_width_px) * ignition * core_fade;

    const float glow_distance = max(edge - half_width_px, 0.0);
    const float near_spread_px = lerp(9.0, 16.0, expansion) * scale;
    const float halo_spread_px = lerp(18.0, 30.0, expansion) * scale;
    const float near_shape = saturate(
        1.0 - glow_distance / max(near_spread_px, 0.001));
    const float halo_shape = saturate(
        1.0 - glow_distance / max(halo_spread_px, 0.001));

    /* Keep the center empty even while the ring is very small. */
    const float center_guard = smoothstep(
        radius_px * 0.28, radius_px * 0.62, distance_px);
    const float near_bloom = near_shape * near_shape *
                             center_guard * ignition * bloom_fade;
    const float diffuse_halo = halo_shape * halo_shape *
                               center_guard * ignition * bloom_fade;
    const float support = vector_ring(
        distance_px, radius_px, half_width_px + 2.6 * scale) *
        ignition * core_fade;

    const float3 tint = click_color(type);
    const float luminance = dot(base, float3(0.2126, 0.7152, 0.0722));
    const float bright_surface = smoothstep(0.62, 0.92, luminance);

    /* Pure additive light disappears on white UIs. On bright surfaces,
     * deepen a slim chromatic support instead of adding a second ring. */
    const float3 core_color = lerp(
        saturate(tint * 1.10), tint * 0.80, bright_surface);
    const float3 support_color = lerp(
        tint * 0.28, tint * 0.50, bright_surface);
    const float3 halo_color = lerp(
        tint, tint * 0.62, bright_surface);

    base = lerp(base, support_color, saturate(
        support * (0.08 + 0.24 * bright_surface)));
    base = lerp(base, halo_color, saturate(
        near_bloom * (0.20 + 0.08 * bright_surface) +
        diffuse_halo * (0.075 + 0.055 * bright_surface)));
    base = lerp(base, core_color, saturate(core * 0.995));
    base += tint * (near_bloom * 0.30 + diffuse_halo * 0.14) *
            (1.0 - bright_surface * 0.78);
    return saturate(base);
}

float3 apply_click(float3 base, float2 output_uv,
                   float4 event_data, float safe_zoom,
                   float2 safe_viewport)
{
    const float type = event_data.w;
    if (type < 0.5)
        return base;

    const float2 delta_px = event_delta_px(
        output_uv, event_data, safe_zoom, safe_viewport);

    /* Conservative screen-space rectangle culling: the entire ring,
     * chromatic support and outer halo fit inside this radius at all times.
     * Most 4K pixels therefore skip costly length/glow math for active clicks,
     * without adding a pass, texture, or reducing the visible halo. */
    const float scale = clamp(
        min(safe_viewport.x, safe_viewport.y) / 1080.0,
        0.85, 1.60);
    const float extent = (64.0 + 30.0 + 6.0) * scale;
    if (abs(delta_px.x) > extent || abs(delta_px.y) > extent)
        return base;

    const float progress = saturate(
        event_data.z / max(event_lifetime(type), 0.001));
    return composite_single_ring(
        base, delta_px, progress, type, safe_viewport);
}

float4 sample_cursor_frame(float2 local_uv)
{
    const float2 safe_grid = max(cursor_atlas_grid, float2(1.0, 1.0));
    const float frame = max(cursor_frame, 0.0);
    const float column = fmod(frame, safe_grid.x);
    const float row = floor(frame / safe_grid.x);
    const float2 atlas_uv =
        (float2(column, row) + saturate(local_uv)) / safe_grid;
    return cursor_atlas.Sample(cursorSampler, atlas_uv);
}

float3 apply_presentation_cursor(float3 base, float2 output_uv,
                                 float safe_zoom,
                                 float2 safe_viewport)
{
    if (cursor_visible < 0.5)
        return base;

    const float2 safe_asset = max(cursor_asset_size, float2(1.0, 1.0));
    const float display_height_px = clamp(cursor_size_px, 8.0, 256.0);
    const float display_width_px =
        display_height_px * safe_asset.x / safe_asset.y;
    const float2 display_size_px =
        float2(display_width_px, display_height_px);
    const float2 display_size_uv = display_size_px / safe_viewport;

    const float2 hotspot_output =
        project_content(cursor_content_position, safe_zoom);
    const float2 safe_hotspot = saturate(cursor_hotspot);
    const float2 top_left =
        hotspot_output - safe_hotspot * display_size_uv;
    const float2 local_uv =
        (output_uv - top_left) / max(display_size_uv, float2(1e-6, 1e-6));

    if (local_uv.x < 0.0 || local_uv.x > 1.0 ||
        local_uv.y < 0.0 || local_uv.y > 1.0) {
        return base;
    }

    /* Restrained one-sample offset shadow gives light/dark separation without
     * turning the cursor into a neon/gaming pointer. */
    const float2 shadow_offset_uv =
        float2(1.35, 1.55) / max(display_size_px, float2(1.0, 1.0));
    const float4 shadow_sample = sample_cursor_frame(local_uv - shadow_offset_uv);
    const float shadow_alpha = shadow_sample.a * 0.22;
    base = lerp(base, float3(0.015, 0.025, 0.040), shadow_alpha);

    const float4 cursor = sample_cursor_frame(local_uv);
    base = lerp(base, cursor.rgb, saturate(cursor.a));
    return base;
}

/* Physical keyboard overlay stays fixed in final output pixels, regardless
 * of camera zoom or pan. Rasterization is retained and only uploaded on new
 * semantic shortcut generation, never per rendered frame. */
float3 apply_keycap_overlay(float3 base, float2 output_uv,
                            float2 safe_viewport)
{
    if (keycap_opacity < 0.005)
        return base;

    const float scale = clamp(safe_viewport.y / 1080.0, 0.75, 1.60);
    const float2 visible_px = max(keycap_size_px * scale,
                                  float2(1.0, 1.0));
    const float2 size_uv = visible_px / safe_viewport;
    const float2 top_left = float2(
        0.50 - 0.50 * size_uv.x,
        1.0 - (42.0 * scale / safe_viewport.y) - size_uv.y);
    const float2 local_uv = (output_uv - top_left) / size_uv;
    if (local_uv.x < 0.0 || local_uv.x > 1.0 ||
        local_uv.y < 0.0 || local_uv.y > 1.0)
        return base;

    const float4 keycaps = keycap_atlas.Sample(keycapSampler, local_uv);
    return lerp(base, keycaps.rgb,
                saturate(keycaps.a * keycap_opacity));
}

float4 PSZoom(FragData f_in) : TARGET
{
    const float safe_zoom = max(zoom_amount, 1.0);
    const float2 safe_viewport = max(viewport_size, float2(1.0, 1.0));
    const float2 sample_uv =
        zoom_center + (f_in.uv - float2(0.5, 0.5)) / safe_zoom;

    /* No click-time texture distortion. The presentation remains optically
     * clean and the analytic vector circles are the only click overlay. */
    float4 color = image.Sample(textureSampler, saturate(sample_uv));

    /* Spotlight guides attention on the scene content. Presentation feedback
     * remains composited above it for maximum readability. */
    color.rgb = apply_spotlight(color.rgb, f_in.uv, safe_viewport);

    color.rgb = apply_click(
        color.rgb, f_in.uv, click_event0, safe_zoom, safe_viewport);
    color.rgb = apply_click(
        color.rgb, f_in.uv, click_event1, safe_zoom, safe_viewport);
    color.rgb = apply_click(
        color.rgb, f_in.uv, click_event2, safe_zoom, safe_viewport);
    color.rgb = apply_click(
        color.rgb, f_in.uv, click_event3, safe_zoom, safe_viewport);

    /* Cursor is composited last so click rings naturally radiate behind it. */
    color.rgb = apply_presentation_cursor(
        color.rgb, f_in.uv, safe_zoom, safe_viewport);

    /* Shortcut keycaps are a final-output HUD, never a camera input. */
    color.rgb = apply_keycap_overlay(color.rgb, f_in.uv, safe_viewport);
    return color;
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = PSZoom(f_in);
    }
}